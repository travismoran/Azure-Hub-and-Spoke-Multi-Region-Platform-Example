# Copy this file to .env, fill in your values, then `source .env`.
# .env is gitignored - NEVER commit real values to this public repository.

# Azure authentication context (used by the azurerm/azapi providers).
# Authenticate with `az login` first. ARM_SUBSCRIPTION_ID is the default and
# fallback subscription: with nothing else set, everything deploys into it.
export ARM_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
export ARM_TENANT_ID="00000000-0000-0000-0000-000000000000"

# Enterprise layout (docs/subscriptions.md): one subscription per role.
# Each unit type is placed by live/root.hcl; unset ones fall back to
# ARM_SUBSCRIPTION_ID. Leave an environment blank until its subscription
# exists - its management group is created empty and its stamps are skipped.
export TG_SUBSCRIPTION_MANAGEMENT="${ARM_SUBSCRIPTION_ID}"   # state storage, management groups
export TG_SUBSCRIPTION_CONNECTIVITY="00000000-0000-0000-0000-000000000000"  # hubs, AVNM, IPAM
export TG_SUBSCRIPTION_DEV="00000000-0000-0000-0000-000000000000"           # dev AKS stamps
export TG_SUBSCRIPTION_PROD=""                                              # prod AKS stamps (when created)

# Remote state storage (created by bootstrap/bootstrap-state.sh in
# TG_SUBSCRIPTION_MANAGEMENT). Storage account names are globally unique -
# pick your own.
export TG_STATE_RESOURCE_GROUP="rg-tfstate-CHANGEME"
export TG_STATE_STORAGE_ACCOUNT="stCHANGEMEtfstate"
export TG_STATE_LOCATION="westus3"

# Global prefix baked into resource names (ACR names must be globally
# unique, so forks of this repo must change this).
export TG_NAME_PREFIX="demo"

# Your public IP in CIDR form, allowed to reach the AKS API server in dev.
# Find it with: curl -s ifconfig.me
export TG_AUTHORIZED_IP="203.0.113.10/32"

# Entra object ID granted 'AKS RBAC Cluster Admin' on the cluster (i.e. who
# can kubectl). Find yours with: az ad signed-in-user show --query id -o tsv
export TG_CLUSTER_ADMIN_OBJECT_ID="00000000-0000-0000-0000-000000000000"
